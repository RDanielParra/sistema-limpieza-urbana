# Etapa 1: Compilación con el SDK de .NET 10
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["LimpiezaUrbana.API.csproj", "./"]
RUN dotnet restore "LimpiezaUrbana.API.csproj"

COPY . .
RUN dotnet publish "LimpiezaUrbana.API.csproj" -c Release -o /app/publish

# Etapa 2: Ejecución ligera en producción
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .

# Render inyecta la variable PORT dinámicamente
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "LimpiezaUrbana.API.dll"]